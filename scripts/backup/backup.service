[Unit]
Description=CircuitHQ Backup — restic encrypted backup
Documentation=https://github.com/rutvik2611/CircuitHQ
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/opt/circuithq/scripts/backup/backup.sh
StandardOutput=journal
StandardError=journal
Environment=RESTIC_ENV=/etc/circuithq/secrets/restic.env
Environment=UPTIME_KUMA_PUSH_URL=https://status.circuithq.internal/api/push/your-monitor-id

# Security hardening
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
DevicePolicy=closed
MemoryDenyWriteExecute=true
LockPersonality=true

[Install]
WantedBy=multi-user.target