# CircuitHQ — cloudflared Tunnel Configuration Template
# =======================================================
# Copy this file to config.yml and fill in your tunnel credentials.
# The credentials.json file is generated by `cloudflared tunnel create`.
#
# See: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
#
# Architecture: Internet → Cloudflare Edge → Tunnel → cloudflared → Traefik
# Traefik handles TLS termination, routing, middleware, and service discovery.

tunnel: YOUR_TUNNEL_ID                  # Run: cloudflared tunnel list
credentials-file: /etc/cloudflared/credentials.json

# Logging level (debug, info, warn, error)
log-level: info

# Metrics server (for Prometheus scraping)
metrics: 0.0.0.0:2000

# Disable Cloudflare's warpbpf (not needed for tunnel-only deployment)
warp-routing:
  enabled: false

# Ingress rules
# Order matters — first match wins. Must end with a catch-all rule.
ingress:

  # ── Traefik Dashboard ─────────────────────────────────────────────
  # Comment out if you don't want the dashboard exposed via CF Tunnel
  # (it's already accessible via Tailscale)
  - hostname: traefik.YOUR-DOMAIN.com          # TODO: replace with your domain
    service: http://traefik:80
    # originRequest:
    #   noTLSVerify: false
    #   originServerName: "traefik.YOUR-DOMAIN.com"

  # ── Example App ───────────────────────────────────────────────────
  # Route to Traefik which handles routing based on Host header
  - hostname: app.YOUR-DOMAIN.com              # TODO: replace with your domain
    service: http://traefik:80

  # ── Catch-all: Return 404 ─────────────────────────────────────────
  # Any hostname not matched above gets a 404 from cloudflared
  - service: http_status:404